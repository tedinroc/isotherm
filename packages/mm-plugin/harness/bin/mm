#!/bin/sh
# Isolated, signed-out mm 7.0.0 host. Never touches the real ~/.metamask or oclif data dir.
# MM_HOME overrides the isolated home (used to test the setup script on a truly fresh home).
H="$(cd "$(dirname "$0")/.." && pwd)"
export HOME="${MM_HOME:-$H/.mmhome}"
export MM_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1
export NODE_OPTIONS="--no-deprecation ${NODE_OPTIONS:-}"
export npm_config_cache="$HOME/.npm-cache"
exec node "$H/host/node_modules/@metamask/agent-wallet/dist/index.js" "$@"
