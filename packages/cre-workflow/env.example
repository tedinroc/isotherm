# NEVER commit real keys. scripts/run-official.sh sets these from ~/.config/isotherm/*.key for the cre process only,
# so you normally do not need a .env file. If you run `cre workflow simulate` by hand, export them in the shell.
#
# Account that sends the (Mock)KeystoneForwarder.report tx during `simulate --broadcast` (pays ~0.02 MON per report).
CRE_ETH_PRIVATE_KEY=<hex, 0x optional>
# EIP-712 attester key; its address must equal Resolver.attester().
ISOTHERM_ATTESTER_KEY_ALL=<hex, 0x optional>
# anvil-fork target only
ISOTHERM_ANVIL_PORT=19310
