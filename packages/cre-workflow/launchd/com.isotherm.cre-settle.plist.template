<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Isotherm CRE settlement, hourly on this Mac (the "simulation forwarder + attestation" mode).
  Runs the OFFICIAL `cre workflow simulate -T testnet ‐‐broadcast` via scripts/run-official.sh at minute 35 of every
  hour (Mac local time; minutes are the same in every zone the settle windows care about). The workflow itself only
  acts from 02:00 station-local time (RCSS 18:00Z, RJTT 17:00Z) and retries hourly until settled or voided (36 h).
  Render with scripts/install-launchd.sh (fills the package path, HOME and the mode flag); see it for load/unload.
  Mode flag: official (default; the CRE engine only) or harness-if-no-login (falls back to the SDK-harness runner,
  which is NOT the CRE engine, while nobody is logged in to CRE).
  Requires: ./setup.sh done, `cre login` done (the session must stay valid), the attester key file present.
  Disable this job before deploying the workflow to a real DON (two signers for one station-date must not overlap).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.isotherm.cre-settle</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PKG__/scripts/run-official.sh</string>
    <string>__MODE_FLAG__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PKG__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PKG__/.tools/bin:__PKG__/.tools/node_modules/.bin:__HOME__/.foundry/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>35</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PKG__/var/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PKG__/var/logs/launchd.err.log</string>
</dict>
</plist>
