<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily ladder roll for tomorrow (station-local). Runs hourly; "--not-before 12:00" makes it act from noon Taipei
     whatever the Mac's own time zone/DST, and the roll is idempotent (an already active ladder costs 0 txs).
     If the loop is running it queues the request for the loop (single writer); otherwise it rolls itself. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>xyz.isotherm.roll</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>~/isotherm-live/packages/maker/scripts/run.sh</string>
    <string>roll</string>
    <string>--station</string><string>RCSS</string>
    <string>--date</string><string>tomorrow</string>
    <string>--not-before</string><string>12:00</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_BIN</key><string>~/.local/bin/node</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:~/.local/bin</string>
  </dict>
  <key>WorkingDirectory</key><string>~/isotherm-live/packages/maker</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>~/isotherm-live/packages/maker/var/log/roll.out.log</string>
  <key>StandardErrorPath</key><string>~/isotherm-live/packages/maker/var/log/roll.err.log</string>
</dict>
</plist>
