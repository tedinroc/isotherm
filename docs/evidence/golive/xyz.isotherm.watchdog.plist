<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Independent kill switch: every 5 min. Does nothing while the loop's heartbeat is fresh; if the loop is dead or
     hung it cancels every maker order of any ladder past its stop-quoting time (and re-checks closed ladders). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>xyz.isotherm.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>~/isotherm-live/packages/maker/scripts/run.sh</string>
    <string>watchdog</string>
    <string>--verify</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_BIN</key><string>~/.local/bin/node</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:~/.local/bin</string>
  </dict>
  <key>WorkingDirectory</key><string>~/isotherm-live/packages/maker</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>~/isotherm-live/packages/maker/var/log/watchdog.out.log</string>
  <key>StandardErrorPath</key><string>~/isotherm-live/packages/maker/var/log/watchdog.err.log</string>
</dict>
</plist>
