# Copy to .env.local (never commit) for `npm run dev`. All optional.
# Dynamic Sandbox environment id (dashboard -> Developers -> SDK & API Keys). Unset = dev-wallet-only build.
# Production builds read it from the committed .env.production (public id); `npm run dev` does not read that file.
VITE_DYNAMIC_ENVIRONMENT_ID=
# Defaults: the deployed Worker and the public Monad testnet RPC.
VITE_API_URL=<former API host>
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_EXPLORER=https://testnet.monadvision.com
# Shown as a red banner, e.g. "Local anvil fork — not the live chain"
VITE_ENV_LABEL=
