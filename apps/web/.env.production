# Committed on purpose: these are PUBLIC build settings, not secrets. A Dynamic environment id is a public identifier
# (it is shipped in every page that uses Dynamic and served by https://app.dynamicauth.com/api/v0/sdk/<id>/settings).
# Source of truth: ~/.config/isotherm/dynamic.env (Dynamic dashboard -> Developers -> SDK & API Keys, Sandbox).
# A dev-wallet-only build: VITE_DYNAMIC_ENVIRONMENT_ID= npm run build   (a shell variable beats this file).
VITE_DYNAMIC_ENVIRONMENT_ID=3eaae4f7-b9bb-4a0a-a578-00ff7008a460
