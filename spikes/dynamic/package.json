{
  "name": "isotherm-dynamic-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Isotherm mobile PWA (Dynamic login + embedded wallet on Monad) and the gasless onboarding relayer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "relayer": "tsx relayer/server.ts",
    "e2e:fork": "tsx scripts/e2e-fork.ts",
    "probe:node-sdk": "tsx scripts/probe-node-sdk.ts"
  },
  "dependencies": {
    "@dynamic-labs/ethereum": "5.9.4",
    "@dynamic-labs/sdk-react-core": "5.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.57.3"
  },
  "optionalDependencies": {
    "@dynamic-labs-wallet/node-evm": "1.1.29"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
