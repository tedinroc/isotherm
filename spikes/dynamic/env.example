# --- PWA (Vite exposes only VITE_* to the browser) ---
# Dynamic dashboard -> Developers -> SDK & API Keys -> Environment ID (use the SANDBOX env)
VITE_DYNAMIC_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
# Public URL of the relayer (relayer/server.ts). Must be HTTPS once the PWA is on Cloudflare Pages.
VITE_RELAYER_URL=http://localhost:8790
# 10143 = Monad testnet (default). 143 = Monad mainnet (do NOT use for this spike).
VITE_CHAIN_ID=10143
# Where gasless AUSD deposits go (Isotherm vault / series contract). Placeholder = relayer itself.
VITE_DEPOSIT_TO=

# --- Relayer (server only; never prefix with VITE_) ---
RELAYER_PORT=8790
RELAYER_RPC_URL=https://testnet-rpc.monad.xyz
RELAYER_CHAIN_ID=10143
# Signer option A (works today): path to a hex private key file, e.g. ~/.config/isotherm/deployer.key
RELAYER_KEY_FILE=
# Signer option B (Dynamic server wallet; needs the dashboard steps in RESULT.md):
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
DYNAMIC_SERVER_WALLET_PASSWORD=
# JSON file holding { walletMetadata } returned by createWalletAccount (written by scripts/create-server-wallet.ts)
DYNAMIC_SERVER_WALLET_FILE=.secrets/server-wallet.json
# Drip sizes (testnet only)
DRIP_MON=0.2
# AUSD per drip, paid from the relayer float; the faucet (10,000/call, ONE global 60 s cooldown) is the fallback
DRIP_AUSD=1000
DRIP_USE_AUSD_FAUCET=1
# Relay policy
# Default destination for TransferWithAuthorization deposits (Isotherm vault). Empty = relayer address.
RELAY_DEPOSIT_TO=
# Extra allowed TransferWithAuthorization destinations (comma separated)
RELAY_ALLOWED_TO=
# Contracts that pull funds via receiveWithAuthorization (series / GaslessDepositor), comma separated
RELAY_ALLOWED_RECEIVERS=
RELAY_MAX_AUSD=1000
RELAY_MAX_TTL=3600
# Monad bills the gas LIMIT: limit = estimate * (100 + GAS_MARGIN_PCT) / 100
GAS_MARGIN_PCT=15
DRIP_COOLDOWN_MS=86400000
CORS_ORIGIN=*
