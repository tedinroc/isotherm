{
  "name": "mm-plugin-isotherm",
  "version": "0.0.1",
  "description": "Isotherm for MetaMask Agent Wallet: quote and trade Asian-city daily max-temperature strike ladders (YES/NO tokens on Kuru order books, Monad).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "oclif-plugin",
    "metamask",
    "agent-wallet",
    "monad",
    "kuru",
    "weather",
    "prediction-markets"
  ],
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && oclif manifest",
    "prepack": "npm run build",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "weather": {
        "description": "Isotherm: Asian-city Tmax strike ladders on Monad"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^7.0.0",
    "capabilities": [],
    "commands": [
      {
        "id": "weather:quote",
        "capabilities": ["wallet-read"],
        "dataAccess": ["accounts", "balances", "network"],
        "targetChains": [10143]
      },
      {
        "id": "weather:memo",
        "capabilities": ["wallet-read", "wallet-submit"],
        "dataAccess": ["accounts", "network"],
        "targetChains": [10143]
      }
    ]
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@metamask/agent-wallet": "^7.0.0"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "7.0.0",
    "oclif": "^4",
    "typescript": "^5"
  }
}
