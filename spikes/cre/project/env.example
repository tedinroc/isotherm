# Copy to .env (gitignored) — or export in the shell. NEVER commit real keys.
# Account that sends the MockKeystoneForwarder.report tx during `simulate --broadcast` (pays gas).
CRE_ETH_PRIVATE_KEY=<hex, 0x optional; e.g. contents of ~/.config/isotherm/deployer.key>
# EIP-712 attester key; its address must be the Resolver `attester`.
ISOTHERM_ATTESTER_KEY_ALL=<hex, 0x optional>
ISOTHERM_ANVIL_PORT=18845
